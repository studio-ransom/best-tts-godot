extends SceneTree

## Measures every bundled voice and writes the per-voice gain table.
##
##   godot --rendering-driver vulkan --script res://tests/test_calibrate_voices.gd
##
## Kokoro's voice packs are not level-matched — switching speaker mid-scene
## steps the volume. A per-voice constant gain fixes that without touching the
## variation *within* a voice, which is real and worth keeping: a short
## exclamation should still be louder than a long calm line.
##
## Loudness is gated (see `KokoroAudio.measure_loudness`), and each voice is
## measured over several sentences of different lengths, because Kokoro picks
## its style row by phoneme count and the level moves a little with it. The
## table records the median.
##
## Re-run this after changing the vocoder, the notch filter, or the voice packs.
## Nothing else reads the .json at build time — it ships as an asset.

const TTSScript := preload("res://addons/best-tts/kokoro_tts.gd")
const AudioScript := preload("res://addons/best-tts/runtime/audio.gd")

const OUT_PATH := "res://addons/best-tts/assets/voice_levels.json"

## Different lengths on purpose: short lines take a different style row.
const LINES := [
	"Halt!",
	"I have wares if you have coin.",
	"The old bridge collapsed under the weight of the caravan, and nobody "
			+ "has crossed the river since.",
]
## IPA for the voices with no G2P, so they are measured too rather than left
## at a gain of 1.0 while everything around them is corrected.
const IPA := [
	"hˈɑlt!",
	"aI hˈæv wˈɛɹz ɪf jˈu hˈæv kˈOn.",
	"ðə ˈOld bɹˈɪʤ kəlˈæpst ˌʌndɜɹ ðə wˈAt ʌv ðə kˈæɹəvˌæn.",
]

var _tts
var _failures := 0


func _init() -> void:
	_tts = TTSScript.new()
	_tts.preload_on_ready = false
	# Measuring the cache would measure whatever gain was baked in last time.
	_tts.cache_enabled = false
	_tts.normalize_loudness = false
	root.add_child(_tts)
	_tts.engine_failed.connect(func(r: String): printerr(r); quit(1))
	_tts.start()
	await _tts.engine_ready

	var voices: PackedStringArray = _tts.list_voices()
	var table := {}
	print("%-12s %8s %8s %7s  %s" % ["voice", "LUFS", "spread", "peak", ""])

	for v in voices:
		var measures := []
		var peak := 0.0
		for i in LINES.size():
			var req = _tts.say(LINES[i], v) if _tts.has_g2p(v) \
					else _tts.say_phonemes(IPA[i], v)
			await req.finished
			if req.stream == null:
				printerr("  %s failed: %s" % [v, req.error])
				_failures += 1
				break
			var m: Dictionary = AudioScript.measure_loudness(req.stream)
			if m["lufs"] == -INF:
				continue
			measures.append(m["lufs"])
			peak = maxf(peak, m["peak"])
		if measures.is_empty():
			continue
		measures.sort()
		var median: float = measures[measures.size() / 2]
		var spread: float = measures[-1] - measures[0]
		table[v] = {"lufs": snappedf(median, 0.01),
				"peak": snappedf(peak, 0.001)}
		print("%-12s %8.2f %8.2f %7.3f  %s" % [v, median, spread, peak,
				"" if _tts.has_g2p(v) else "(via IPA)"])

	if table.is_empty():
		printerr("FAIL: measured nothing")
		quit(1)
		return

	# The target is the median voice: correcting to the quietest would throw
	# away headroom on everything, and correcting to the loudest would need
	# gains above 1.0 that the peaks cannot take.
	var all := []
	for v in table:
		all.append(float(table[v]["lufs"]))
	all.sort()
	var target: float = all[all.size() / 2]
	var lo: float = all[0]
	var hi: float = all[-1]

	# How much of the correction the peak ceiling refuses to allow. A voice
	# that is quiet *and* already peaking cannot be brought all the way up
	# without clipping, and quietly clipping it would be worse than leaving it.
	var clamped := 0
	var worst_residual := 0.0
	for v in table:
		var want: float = pow(10.0, (target - float(table[v]["lufs"])) / 20.0)
		var ceiling: float = 0.99 / maxf(0.001, float(table[v]["peak"]))
		if want > ceiling:
			clamped += 1
			worst_residual = maxf(worst_residual,
					20.0 * log(want / ceiling) / log(10.0))

	print("\n%d voices measured" % table.size())
	print("  spread before   %.1f dB  (%.1f to %.1f LUFS)" % [hi - lo, lo, hi])
	print("  target          %.2f LUFS (the median voice)" % target)
	print("  peak-limited    %d voice(s), worst residual %.1f dB"
			% [clamped, worst_residual])

	var doc := {
		"_comment": "Generated by tests/test_calibrate_voices.gd — do not "
				+ "hand-edit. Regenerate after changing the vocoder or the "
				+ "voice packs.",
		"target_lufs": snappedf(target, 0.01),
		"voices": table,
	}
	var f := FileAccess.open(OUT_PATH, FileAccess.WRITE)
	if f == null:
		printerr("FAIL: cannot write %s" % OUT_PATH)
		quit(1)
		return
	f.store_string(JSON.stringify(doc, "  "))
	f.close()
	print("  wrote %s" % OUT_PATH)
	quit(1 if _failures > 0 else 0)
